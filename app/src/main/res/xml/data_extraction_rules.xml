<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 et plus. Seuls les chemins inclus sont sauvegardés ou transférés : la base et les
  réglages. Les clés API chiffrées (datastore/secrets.preferences_pb) ne le sont jamais.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
